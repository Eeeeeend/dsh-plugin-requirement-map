{
  "name": "dsh-plugin-requirement-map",
  "version": "0.1.0",
  "description": "DSH 插件：把项目需求台账渲染成可交互思维导图，自动发现台账、后台生成、悬停展开、状态可直接编辑。／ DSH plugin: render a project requirement ledger as an interactive mind map with auto-discovery, background generation, hover preview, and inline status editing.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "ledger.js",
    "generate.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "requirements",
    "requirement-map",
    "mind-map",
    "requirement-tracking",
    "ledger",
    "project-management",
    "hermes"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  },
  "author": "Eeeeeend",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eeeeeend/dsh-plugin-requirement-map.git"
  },
  "homepage": "https://github.com/Eeeeeend/dsh-plugin-requirement-map#readme",
  "bugs": {
    "url": "https://github.com/Eeeeeend/dsh-plugin-requirement-map/issues"
  }
}
